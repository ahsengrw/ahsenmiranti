# Robust Flutter Podfile for iOS 15.0+
platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = '1'

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "Generated.xcconfig must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/\s*FLUTTER_ROOT\s*=\s*(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in Generated.xcconfig. Try deleting Generated.xcconfig and regenerate it by running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'

      # Fix for Xcode 15+ "Build input file cannot be found" errors
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'

      # Fix for Privacy Bundle in modern Xcode versions
      if target.name.include? 'privacy'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['GENERATE_INFOPLIST_FILE'] = 'YES'
      end
    end
  end
end
