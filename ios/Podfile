platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

project 'Runner', {
  'Debug' => :debug,
  'Release' => :release,
  'Profile' => :profile,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)

  unless File.exist?(generated_xcode_build_settings_path)
    raise "Generated.xcconfig must exist. Please run 'flutter pub get' on this Mac first."
  end

  path = nil
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/\s*FLUTTER_ROOT\s*=\s*(.*)/)
    if matches
      path = matches[1].strip
      break
    end
  end

  # Check if the path looks like a Windows path (contains backslashes or drive letters)
  if path.nil? || path.include?('\\') || path.include?(':')
    # Try to find flutter path automatically on Mac
    auto_path = `which flutter`.strip
    if auto_path.empty?
      raise "Windows paths detected in Generated.xcconfig and 'flutter' command not found in PATH. Please run 'flutter pub get' on this Mac."
    end
    # 'which flutter' gives path to bin/flutter, we need the root
    return File.expand_path(File.join('..', '..'), auto_path)
  end

  return path
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Force 15.0 for all pods to avoid Stripe/GoogleMaps version mismatches
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
